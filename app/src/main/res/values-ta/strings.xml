    <string name="sandbox_title">சாண்ட்பாக்ஸ்</string>
    <string name="sandbox_subtitle">உங்கள் போனில் ஒரு தனி இடம், Android தானே தனியாக வைத்திருக்கிறது.</string>
    <string name="sandbox_admin_desc">TwinnDroid சாண்ட்பாக்ஸ் பணிச் சுயவிவரத்தை உருவாக்கி நிர்வகிக்க அனுமதிக்கும். உங்கள் போனின் மற்ற பகுதிகள் மீது இதற்குக் கட்டுப்பாடு இல்லை.</string>
    <string name="sandbox_setup_title">உங்கள் சாண்ட்பாக்ஸை உருவாக்குங்கள்</string>
    <string name="sandbox_setup_desc">சாண்ட்பாக்ஸில் உள்ள ஆப்ஸுக்குச் சொந்த சேமிப்பகம், கணக்குகள், தொடர்புகள் உண்டு; அவை உங்கள் போனின் மற்ற பகுதிகளைப் பார்க்க முடியாது. குளோன் செய்ய முடியாதவை உட்பட எந்த ஆப்ஸையும் மாற்றாமல் சேர்க்கலாம், அனுமதிக்கும் ஆப்ஸுக்கு விரும்பும் அளவு குளோன்களையும் சேர்க்கலாம். Android ஒரு சிறிய அமைப்பில் உங்களை வழிநடத்தும்.</string>
    <string name="sandbox_setup_button">சாண்ட்பாக்ஸை உருவாக்கு</string>
    <string name="sandbox_taken_title">உங்கள் பணிச் சுயவிவரம் பயன்பாட்டில் உள்ளது</string>
    <string name="sandbox_taken_desc">Android ஒரு போனுக்கு ஒரே பணிச் சுயவிவரத்தை அனுமதிக்கிறது, வேறொரு ஆப்ஸ் (Shelter அல்லது உங்கள் அலுவலகம் போல) அதைப் பயன்படுத்துகிறது. சாண்ட்பாக்ஸைப் பயன்படுத்த முதலில் அமைப்புகளில் அந்தச் சுயவிவரத்தை அகற்றவும். உள்ளே உள்ள அனைத்தும் நீங்கும், எனவே முதலில் காப்புப்பிரதி எடுக்கவும்.</string>
    <string name="sandbox_paused_title">சாண்ட்பாக்ஸ் இடைநிறுத்தப்பட்டுள்ளது</string>
    <string name="sandbox_paused_desc">பணி ஆப்ஸ் அணைக்கப்பட்டுள்ளன, எனவே சாண்ட்பாக்ஸ் உறங்குகிறது. விரைவு அமைப்புகள் அல்லது ஆப்ஸ் டிராயரின் பணித் தாவலில் இயக்கவும்.</string>
    <string name="sandbox_unsupported_title">இந்த போனில் கிடைக்கவில்லை</string>
    <string name="sandbox_unsupported_desc">இந்த போனின் Android பணிச் சுயவிவரங்களை வழங்கவில்லை, சாண்ட்பாக்ஸ் அவற்றையே சார்ந்துள்ளது. வலுவூட்டிய குளோன்கள் தொடர்ந்து வேலை செய்யும்.</string>
    <string name="sandbox_add_app">ஆப்ஸைச் சேர்</string>
    <string name="sandbox_add_apk">APK சேர்</string>
    <string name="sandbox_add_hint">ஆப்ஸை மாற்றாமல் சேர்க்கும், எனவே குளோன் செய்ய முடியாவிட்டாலும் இயங்கும். இதனால் ஒரு நகல் கிடைக்கும். மேலும் வேண்டுமெனில், ஆப்ஸை குளோன் செய்ய முடிந்தால் புதிய குளோனைப் பயன்படுத்தி அங்கே சாண்ட்பாக்ஸை இயக்கவும்.</string>
    <string name="sandbox_empty">இங்கே இன்னும் எதுவும் இல்லை. தொடங்க ஒரு ஆப்ஸைச் சேர்க்கவும்.</string>
    <string name="sandbox_refresh">புதுப்பி</string>
    <string name="sandbox_frozen">உறைந்தது</string>
    <string name="sandbox_freeze">உறையவை</string>
    <string name="sandbox_unfreeze">உறைவை நீக்கு</string>
    <string name="sandbox_freeze_all">அனைத்தையும் உறையவை</string>
    <string name="sandbox_app_options">விருப்பங்கள்</string>
    <string name="sandbox_reset">ஆப்ஸ் தரவை மீட்டமை</string>
    <string name="sandbox_reset_done">%1$s மீட்டமைக்கப்பட்டது.</string>
    <string name="sandbox_reset_failed">%1$s மீட்டமைக்க முடியவில்லை.</string>
    <string name="sandbox_copy_out">முதன்மைச் சுயவிவரத்துக்கு நகலெடு</string>
    <string name="sandbox_uninstall">நிறுவல்நீக்கு</string>
    <string name="sandbox_rules">சாண்ட்பாக்ஸ் விதிகள்</string>
    <string name="sandbox_rule_clipboard">நகலெடு, ஒட்டு தடு</string>
    <string name="sandbox_rule_clipboard_desc">சாண்ட்பாக்ஸில் நகலெடுத்த உரையை வெளியே ஒட்ட முடியாது, மறுபுறமும் முடியாது.</string>
    <string name="sandbox_rule_share">உள்ளே பகிர்வதைத் தடு</string>
    <string name="sandbox_rule_share_desc">தனிப்பட்ட ஆப்ஸ் சாண்ட்பாக்ஸுக்குக் கோப்புகளையோ இணைப்புகளையோ அனுப்ப முடியாது.</string>
    <string name="sandbox_rule_contacts">தொடர்புத் தேடலைத் தடு</string>
    <string name="sandbox_rule_contacts_desc">உங்கள் தனிப்பட்ட ஆப்ஸ் சாண்ட்பாக்ஸில் சேமித்த தொடர்புகளைப் பார்க்க முடியாது.</string>
    <string name="sandbox_rule_debug">adb, Shizuku அனுமதி</string>
    <string name="sandbox_rule_debug_desc">டெவலப்பர் கருவிகள் சாண்ட்பாக்ஸை அணுக அனுமதிக்கும். தேவையில்லையெனில் அணைத்து வைக்கவும்.</string>
    <string name="sandbox_delete">சாண்ட்பாக்ஸை நீக்கு</string>
    <string name="sandbox_delete_title">சாண்ட்பாக்ஸை நீக்கவா?</string>
    <string name="sandbox_delete_desc">உள்ளே உள்ள அனைத்து ஆப்ஸும் தரவும் நிரந்தரமாக நீக்கப்படும். சாண்ட்பாக்ஸுக்கு வெளியே உள்ள ஆப்ஸ் பாதிக்கப்படாது.</string>
    <string name="sandbox_block_hint">இந்த ஆப்ஸுக்கு அந்த அனுமதியைத் தடுக்க ஸ்விட்சை இயக்கவும்.</string>
    <string name="sandbox_widgets">விட்ஜெட்களை அனுமதி</string>
    <string name="sandbox_widgets_desc">இந்த ஆப்ஸின் விட்ஜெட்கள் முகப்புத் திரையில் தோன்ற அனுமதிக்கும்.</string>
    <string name="sandbox_interaction">சுயவிவரங்களுக்கு இடையே தொடர்பை அனுமதி</string>
    <string name="sandbox_interaction_desc">ஆதரித்தால், சாண்ட்பாக்ஸுக்கு வெளியே உள்ள தன் நகலுடன் பேச அனுமதிக்கும்.</string>
    <string name="perm_camera">கேமரா</string>
    <string name="perm_microphone">மைக்ரோஃபோன்</string>
    <string name="perm_location">இருப்பிடம்</string>
    <string name="perm_contacts">தொடர்புகள்</string>
    <string name="perm_calendar">காலெண்டர்</string>
    <string name="perm_phone">போன், அழைப்புப் பதிவு</string>
    <string name="perm_sms">SMS</string>
    <string name="perm_files">படங்கள், மீடியா, கோப்புகள்</string>
    <string name="perm_nearby">அருகிலுள்ள சாதனங்கள்</string>
    <string name="perm_sensors">உடல், செயல்பாட்டு சென்சார்கள்</string>
    <string name="sandbox_auto_freeze">தானியங்கி உறைவு</string>
    <string name="sandbox_auto_freeze_desc">திரை பூட்டப்படும்போது இந்த ஆப்ஸை உறையவைக்கும். TwinnDroid அல்லது குறுக்குவழியில் திறந்தால் மீண்டும் விழிக்கும்.</string>
    <string name="sandbox_auto_freeze_running">போன் பூட்டப்பட்டதும் சாண்ட்பாக்ஸ் ஆப்ஸை உறையவைக்கக் காத்திருக்கிறது</string>
    <string name="sandbox_skip_playing">ஆடியோ இயங்கும்போது தவிர்</string>
    <string name="sandbox_skip_playing_desc">ஏதாவது இயங்கும்போது பூட்டிய போனிலும் ஆப்ஸை விழிப்பில் வைக்கும்.</string>
    <string name="sandbox_freeze_delay">தானியங்கி உறைவு தாமதம்: %1$d விநாடிகள்</string>
    <string name="sandbox_freeze_shortcut">அனைத்தும் உறைய குறுக்குவழி சேர்</string>
    <string name="sandbox_shortcut">குறுக்குவழி சேர்</string>
    <string name="sandbox_send_files">கோப்புகளை உள்ளே அனுப்பு</string>
    <string name="sandbox_bring_files">கோப்புகளை வெளியே எடு</string>
    <string name="sandbox_files_saved">சாண்ட்பாக்ஸில் Download/TwinnDroid-இல் சேமிக்கப்பட்டது.</string>
    <string name="sandbox_payment">NFC கட்டண ஸ்டப்</string>
    <string name="sandbox_payment_desc">தொடர்பில்லா கட்டண அமைப்பைத் தோன்றச் செய்யும், சாண்ட்பாக்ஸில் உள்ள கட்டண ஆப்ஸ் NFC-ஐப் பயன்படுத்த முடியும்.</string>
    <string name="chip_in_sandbox">சாண்ட்பாக்ஸில்</string>
    <string name="chip_hardened">வலுவூட்டப்பட்டது</string>
    <string name="cell_section">சாண்ட்பாக்ஸ், தனிமைப்படுத்தல்</string>
    <string name="cell_normal">சாதாரண குளோன்</string>
    <string name="cell_outside">உங்கள் மற்ற ஆப்ஸுடன் நிறுவப்பட்டது</string>
    <string name="cell_in_sandbox">சாண்ட்பாக்ஸில் நிறுவு</string>
    <string name="cell_in_sandbox_desc">TwinnDroid-இன் பணிச் சுயவிவரத்தில், உங்கள் போனின் மற்ற பகுதிகளிலிருந்து தனியாக இயங்கும்.</string>
    <string name="cell_sandbox_missing">முதலில் சாண்ட்பாக்ஸ் தாவலில் சாண்ட்பாக்ஸை உருவாக்கவும்.</string>
    <string name="cell_harden">இந்த குளோனை வலுவூட்டு</string>
    <string name="cell_harden_desc">இந்த நகலை மற்ற ஆப்ஸிடமிருந்தும் உங்கள் மற்ற குளோன்களிடமிருந்தும் பிரிக்கும். Android இதைச் செயல்படுத்துகிறது, எனவே ஆப்ஸ் தப்ப முடியாது.</string>
    <string name="cell_own_key">சொந்த கையொப்பச் சாவி</string>
    <string name="cell_own_key_desc">இதற்குச் சொந்த சாதன ID தரும், அதனால் அந்த வழியில் உங்கள் மற்ற குளோன்களுடன் இணைக்க முடியாது.</string>
    <string name="cell_hide_apps">மற்ற ஆப்ஸை மறை</string>
    <string name="cell_hide_apps_desc">வேறு என்ன நிறுவப்பட்டுள்ளது என்று இது பார்க்க முடியாது. Android 11 அல்லது புதியதற்காக உருவாக்கப்பட்ட ஆப்ஸில் மட்டும் வேலை செய்யும்.</string>
    <string name="cell_private">தனிப்பட்ட கூறுகள்</string>
    <string name="cell_private_desc">மற்ற ஆப்ஸ் இதன் திரைகளைத் திறக்கவோ இதை அழைக்கவோ முடியாது. ஐகான், இணைய இணைப்புகள், விட்ஜெட்கள் தொடர்ந்து வேலை செய்யும்.</string>
    <string name="cell_no_storage">பகிர்ந்த சேமிப்பகம் இல்லை</string>
    <string name="cell_no_storage_desc">இதற்குச் சொந்த தனிப்பட்ட கோப்புறை மட்டுமே, உங்கள் படங்களும் கோப்புகளும் இல்லை.</string>
    <string name="cell_no_backup">காப்புப்பிரதி இல்லை</string>
    <string name="cell_no_backup_desc">இதன் தரவை கிளவுட், adb காப்புப்பிரதிகளிலிருந்து விலக்கி வைக்கும்.</string>
    <string name="cell_no_ad_id">விளம்பர ID இல்லை</string>
    <string name="cell_no_ad_id_desc">உங்கள் விளம்பர ID-க்கான இதன் அணுகலை நீக்கும்.</string>
    <string name="cell_no_boot">தொடக்கத்தில் இயங்காது</string>
    <string name="cell_no_boot_desc">போன் இயங்கும்போது இது தானாகத் தொடங்காது.</string>
    <string name="cell_no_internet">இணையம் இல்லை</string>
    <string name="cell_no_internet_desc">அனைத்து நெட்வொர்க் அணுகலையும் தடுக்கும். பெரும்பாலான ஆப்ஸுக்கு இது தேவை, எனவே நம்புவதற்கு முன் சோதிக்கவும்.</string>
    <string name="cell_reinstall_warning">கையொப்பச் சாவியை மாற்றவோ, குளோனை சாண்ட்பாக்ஸுக்குள் அல்லது வெளியே நகர்த்தவோ புதிய நிறுவல் தேவை. முதலில் பழைய நகலை நிறுவல்நீக்கவும்; அதன் தரவு வராது.</string>
    <string name="tamper_try_sandbox">பதிலாக சாண்ட்பாக்ஸ் தாவலை முயற்சிக்கவும்: அது அசல் ஆப்ஸை மாற்றாமல் இரண்டாம் நகலாக இயக்கும்.</string>
    <string name="sandbox_no_answer">சாண்ட்பாக்ஸ் பதிலளிக்கவில்லை. பணி ஆப்ஸ் இயங்குகின்றனவா எனப் பார்த்து மீண்டும் முயற்சிக்கவும்.</string>
