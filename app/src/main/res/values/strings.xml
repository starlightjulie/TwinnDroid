    <string name="cell_harden_desc">Walls this copy off from other apps, including your other clones. Android enforces it, so the app can\'t get around it.</string>
    <string name="cell_own_key">Own signing key</string>
    <string name="cell_own_key_desc">Gives it a device ID of its own, so it can\'t be linked to your other clones that way.</string>
    <string name="cell_hide_apps">Hide other apps</string>
    <string name="cell_hide_apps_desc">It can\'t see what else is installed. Only works on apps built for Android 11 or newer.</string>
    <string name="cell_private">Private components</string>
    <string name="cell_private_desc">Other apps can\'t open its screens or call into it. Its icon, web links and widgets keep working.</string>
    <string name="cell_no_storage">No shared storage</string>
    <string name="cell_no_storage_desc">It only gets its own private folder, not your photos and files.</string>
    <string name="cell_no_backup">No backups</string>
    <string name="cell_no_backup_desc">Keeps its data out of cloud and adb backups.</string>
    <string name="cell_no_ad_id">No advertising ID</string>
    <string name="cell_no_ad_id_desc">Removes its access to your ad ID.</string>
    <string name="cell_no_boot">No start at boot</string>
    <string name="cell_no_boot_desc">It won\'t start by itself when your phone turns on.</string>
    <string name="cell_no_internet">No internet</string>
    <string name="cell_no_internet_desc">Blocks all network access. Most apps need it, so test before relying on this.</string>
    <string name="cell_reinstall_warning">Changing the signing key, or moving a clone in or out of the sandbox, needs a fresh install. Uninstall the old copy first; its data can\'t come with it.</string>
    <string name="tamper_try_sandbox">Try the Sandbox tab instead: it runs the original app unchanged, as a second copy.</string>
    <string name="sandbox_no_answer">The sandbox didn\'t answer. Make sure work apps are on, then try again.</string>
    <string name="sandbox_files_out">Saved to Download/TwinnDroid on your phone.</string>
    <string name="sandbox_install_blocked">The sandbox needs permission to install apps. Turn on \"Allow from this source\" for it, then try again.</string>
    <string name="tamper_add_to_sandbox">Add original to sandbox</string>
    <string name="cell_tamper_note">Hardening won\'t fix this app. It rejects any changed copy, and a clone is always a changed copy. Go back and tap Add original to sandbox.</string>
