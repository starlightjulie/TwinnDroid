    <string name="tab_sandbox">Sandbox</string>
    <string name="sandbox_title">Sandbox</string>
    <string name="sandbox_subtitle">A separate space on your phone, kept apart by Android itself.</string>
    <string name="sandbox_admin_desc">Lets TwinnDroid create and manage its sandbox work profile. It has no control over the rest of your phone.</string>
    <string name="sandbox_profile_name" translatable="false">TwinnDroid Sandbox</string>
    <string name="sandbox_setup_title">Create your sandbox</string>
    <string name="sandbox_setup_desc">Apps in the sandbox get their own storage, accounts and contacts, and can\'t see the rest of your phone. You can add any app without changing it, even ones that can\'t be cloned, plus as many clones as you like of apps that allow it. Android will walk you through a short setup.</string>
    <string name="sandbox_setup_button">Create sandbox</string>
    <string name="sandbox_taken_title">Your work profile is in use</string>
    <string name="sandbox_taken_desc">Android allows one work profile per phone, and another app (like Shelter, or your workplace) already has it. To use the sandbox, remove that work profile first in Settings. That deletes everything inside it, so back it up first.</string>
    <string name="sandbox_paused_title">Sandbox is paused</string>
    <string name="sandbox_paused_desc">Work apps are turned off, so the sandbox is asleep. Turn on work apps from quick settings or your app drawer\'s work tab.</string>
    <string name="sandbox_unsupported_title">Not available on this phone</string>
    <string name="sandbox_unsupported_desc">This phone\'s Android doesn\'t offer work profiles, which the sandbox is built on. Hardened clones still work.</string>
    <string name="sandbox_add_app">Add app</string>
    <string name="sandbox_add_apk">Add APK</string>
    <string name="sandbox_add_hint">Adds the app unchanged, so it works even if it can\'t be cloned. That gives you one copy. For more, use New clone and turn on the sandbox there, if the app can be cloned.</string>
